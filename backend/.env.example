# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database ────────────────────────────────────────────────────────────────
# SQLite (default — no setup required for local dev):
DATABASE_URL=sqlite:///./gold_watcher.db

# PostgreSQL / Supabase (uncomment and fill in for production):
# DATABASE_URL=postgresql://user:password@host:5432/gold_watcher

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate a strong random value:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# JWT token lifetime in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Telegram ────────────────────────────────────────────────────────────────
# 1. Create a bot via @BotFather → copy the token.
# 2. Set the username (without @) — shown in the connect deep-link.
# 3. Register a webhook with Telegram (see README) and set a secret for verification.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=YourGoldWatcherBot
TELEGRAM_WEBHOOK_SECRET=any-random-string-you-choose

# ── Scheduler ───────────────────────────────────────────────────────────────
# How often the price-fetch job runs (hours).
# Users get their summary at their own notify_interval_hours (default 48h).
# Keep this <= the smallest user interval so data is always fresh.
FETCH_INTERVAL_HOURS=12

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
